# SINH TỰ ĐỘNG bởi scripts/configure.py từ config.yml — KHÔNG sửa tay, KHÔNG commit.
# Dùng bởi: app.py, scripts/*.sh và docker compose (biến ${...} trong docker-compose.yml).

# ---- Docker compose ----
COMPOSE_PROJECT_NAME=mailu
MAILU_VERSION={{mailu.version}}
MAILU_DATA_DIR={{mailu.data_dir}}
MAILU_HTTP_BIND={{mailu.http_bind}}
MAILU_SUBNET={{mailu.subnet}}
MAILU_RESOLVER_IP={{mailu.resolver_ip}}
TLS_CERT_NAME={{mailu.tls.letsencrypt_name}}

# ---- Mail API (app.py) ----
IMAP_HOST={{api.imap_host}}
IMAP_PORT={{api.imap_port}}
# nháy đơn: giữ nguyên ký tự đặc biệt ($, #...) khi docker compose đọc .env
MAILBOX_PASSWORD='{{api.mailbox_password}}'
API_HOST={{api.host}}
API_PORT={{api.port}}
WAIT_TIMEOUT={{api.wait_timeout}}
MAX_WAIT_TIMEOUT={{api.max_wait_timeout}}
POLL_INTERVAL={{api.poll_interval}}
LOG_LEVEL={{api.log_level}}
TRUSTED_PROXIES={{api.trusted_proxies}}
API_WHITELIST_FILE=whitelist/api.txt

# ---- Firewall (scripts/firewall-whitelist.sh) ----
MAIL_WHITELIST_FILE=whitelist/mail.txt
MAIL_PROTECTED_PORTS={{firewall.mail_protected_ports}}
FIREWALL_PROTECT_API={{firewall.protect_api}}
EXT_IFACE={{server.ext_iface}}

# ---- nginx (scripts/nginx-setup.sh) ----
MAIL_HOSTNAME={{mail.hostname}}
NGINX_MAIL_MODE={{nginx.mail_mode}}
LETSENCRYPT_EMAIL={{nginx.letsencrypt_email}}
